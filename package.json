{
  "name": "amazon-image-studio",
  "private": true,
  "version": "1.6.0",
  "description": "跨境Image工作台 Windows desktop installer",
  "author": "JackLuo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "npm run build && electron .",
    "mock:api": "node scripts/mock-image-api.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "build:installer": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-installer.ps1",
    "test:installer-config": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-windows-installer.ps1",
    "deploy:cf": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:electron": "node --test electron/ipcHandlers.test.cjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "core-js": "^3.49.0",
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "three": "^0.185.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.0",
    "eslint": "^10.9.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.3.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.88.0"
  }
}
